{
  "name": "@denizkoekden/ts-prometheus",
  "version": "0.4.0",
  "license": "MIT",
  "exports": "./mod.ts",
  "publish": {
    "exclude": [
      "example/",
      "**/*_test.ts",
      "test_deps.ts",
      ".github/",
      "deno.lock"
    ]
  },
  "lint": {
    "exclude": ["example/"]
  },
  "fmt": {
    "options": {
      "useTabs": false,
      "lineWidth": 80,
      "indentWidth": 2,
      "singleQuote": false,
      "proseWrap": "preserve"
    }
  }
}
